.le-root {
    flex-grow: 1;
    padding: 8px;
}

.le-section {
    background-color: rgba(0, 0, 0, 0.15);
    border-radius: 4px;
    padding: 8px;
    margin-bottom: 8px;
}

.le-section__title {
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}

.le-row {
    flex-direction: row;
    align-items: center;
}

.le-create-button {
    background-color: rgb(51, 153, 51);
    color: white;
    -unity-font-style: bold;
    height: 28px;
    margin-top: 4px;
}

.le-delete-button {
    background-color: rgb(178, 60, 60);
    color: white;
    -unity-font-style: bold;
}

/* ---- Grid ---- */

.le-grid {
    flex-direction: column;
    align-self: center;
    padding: 6px;
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 4px;
}

.le-grid__row {
    flex-direction: row;
}

.le-cell {
    width: 64px;
    height: 64px;
    margin: 1px;
    background-color: rgb(110, 110, 110);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.4);
    justify-content: center;
    align-items: center;
}

.le-cell--empty {
    background-color: rgb(90, 90, 90);
}

.le-cell--selected {
    border-color: rgb(80, 220, 80);
    border-width: 2px;
}

.le-cell--drop-target {
    border-color: rgb(90, 170, 255);
    border-width: 2px;
    background-color: rgba(90, 170, 255, 0.25);
}

.le-cell--drop-invalid {
    border-color: rgb(220, 90, 90);
    border-width: 2px;
    background-color: rgba(220, 90, 90, 0.22);
}

.le-stamp-icon {
    position: absolute;
    opacity: 0.55;
}

/* ---- Palette ---- */

.le-palette {
    flex-grow: 1;
    padding: 6px;
    background-color: rgba(0, 0, 0, 0.2);
}

.le-palette__tiles {
    flex-direction: row;
    flex-wrap: wrap;
}

.le-palette-tile {
    width: 60px;
    height: 72px;
    margin: 3px;
    padding-top: 2px;
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.4);
    align-items: center;
}

.le-palette-tile:hover {
    background-color: rgba(90, 170, 255, 0.2);
    border-color: rgb(90, 170, 255);
}

.le-palette-tile__icon {
    width: 48px;
    height: 48px;
}

.le-palette-tile__label {
    font-size: 9px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    max-width: 58px;
}

.le-drag-ghost {
    position: absolute;
    width: 56px;
    height: 56px;
    opacity: 0.75;
    /* lifted above the rest of the window; ignores the mouse */
}

.le-cell__icon {
    width: 56px;
    height: 56px;
    position: absolute;
}

.le-cell__id {
    position: absolute;
    bottom: 1px;
    font-size: 10px;
    color: white;
    -unity-text-align: lower-center;
}

.le-cell__arrow {
    position: absolute;
    top: -2px;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(80, 220, 80);
}

/* ---- Popup / block list ---- */

.le-block-row {
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.15);
    border-radius: 3px;
    padding: 2px;
    margin-bottom: 2px;
}

.le-block-row__icon {
    width: 32px;
    height: 32px;
}

.le-block-row__label {
    margin-left: 6px;
    flex-grow: 1;
}

.le-rotation-row {
    flex-direction: row;
    justify-content: space-between;
}

.le-rotation-button {
    flex-grow: 1;
    height: 34px;
    white-space: normal;
}

.le-clear-button {
    background-color: rgb(200, 70, 70);
    color: white;
    -unity-font-style: bold;
    height: 28px;
}
